# Backend jest wystawiony przez nginx pod ścieżką /api (port 80), a nie
# bezpośrednio na porcie 8000 - zobacz nginx/nginx.conf i docker-compose.yml.
#
# - symulator iOS / komputer z uruchomionym `docker compose up`: http://localhost/api
# - fizyczny telefon w tej samej sieci Wi-Fi co komputer: http://<IP-LAN-komputera>/api
# - emulator Androida: http://10.0.2.2/api
# - build produkcyjny: publiczny URL backendu, np. https://health.twojadomena.pl/api
EXPO_PUBLIC_API_URL=http://localhost/api
