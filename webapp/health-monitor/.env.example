# Skopiuj ten plik do .env i uzupełnij wartości:
#   cp .env.example .env

# Hasło do bazy Postgres (dowolne, wymyślone przez Ciebie)
DB_PASSWORD=changeme

# Dane logowania do Garmin Connect — wymagane tylko jeśli chcesz
# automatycznej synchronizacji danych z zegarka Garmin.
# Aplikacja (dashboard, ankiety, ciśnienie) działa bez nich.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Opcjonalnie — tryb "cloud" dla Mi Band (patrz README, domyślnie
# używany jest tryb "file": wrzucasz eksportowane JSON-y do
# ./miband_imports).
XIAOMI_EMAIL=
XIAOMI_PASSWORD=
XIAOMI_REGION=us
